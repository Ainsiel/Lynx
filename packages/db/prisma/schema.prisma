datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

enum Role {
  USER
  ADMIN
}

model User {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  email          String              @unique
  passwordHash   String?             @map("password_hash")
  githubId       String?             @unique @map("github_id")
  githubUsername  String?             @map("github_username")
  avatarUrl      String?             @map("avatar_url")
  role           Role                @default(USER)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz()
  refreshTokens   RefreshToken[]
  passwordResets  PasswordResetToken[]
  urls            Url[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jti       String    @unique
  userId    String    @map("user_id") @db.Uuid
  token     String
  family    String    @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  usedAt    DateTime? @map("used_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Url {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String?  @map("owner_id") @db.Uuid
  originalUrl String   @map("original_url")
  slug        String   @unique @db.VarChar(16)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  owner        User?         @relation(fields: [ownerId], references: [id])
  clicks       Click[]
  dailyStats   DailyStats[]
  statsCountry StatsCountry[]
  statsDevice  StatsDevice[]

  @@map("urls")
}

model Click {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url        Url      @relation(fields: [urlId], references: [id], onDelete: Cascade)
  urlId      String   @map("url_id") @db.Uuid
  eventId    String   @unique @map("event_id") @db.Uuid
  ip         String?  @db.Inet
  country    String?  @db.VarChar(2)
  device     String?  @db.VarChar(20)
  userAgent  String?  @map("user_agent")
  occurredAt DateTime @map("occurred_at") @db.Timestamptz()

  @@index([urlId, occurredAt(sort: Desc)], map: "idx_clicks_url_occurred")
  @@map("clicks")
}

model DailyStats {
  url    Url      @relation(fields: [urlId], references: [id])
  urlId  String   @map("url_id") @db.Uuid
  day    DateTime @db.Date
  clicks BigInt   @default(0) @db.BigInt

  @@id([urlId, day])
  @@map("daily_stats")
}

model StatsCountry {
  url     Url      @relation(fields: [urlId], references: [id])
  urlId   String   @map("url_id") @db.Uuid
  day     DateTime @db.Date
  country String   @db.VarChar(2)
  clicks  BigInt   @default(0) @db.BigInt

  @@id([urlId, day, country])
  @@map("stats_country")
}

model StatsDevice {
  url    Url      @relation(fields: [urlId], references: [id])
  urlId  String   @map("url_id") @db.Uuid
  day    DateTime @db.Date
  device String   @db.VarChar(20)
  clicks BigInt   @default(0) @db.BigInt

  @@id([urlId, day, device])
  @@map("stats_device")
}
